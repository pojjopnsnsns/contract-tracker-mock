PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-with-your-database-password
PGDATABASE=contract_tracker
PORT=4000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4000
# Use none for a frontend on a different site over HTTPS (also enables Secure).
SESSION_COOKIE_SAMESITE=strict
ALERT_TIMEZONE=Asia/Bangkok
# Opt-in only; these features are never enabled by importing or testing modules.
SEED_MOCK_DATA=false
ENABLE_DAILY_ALERTS=false
